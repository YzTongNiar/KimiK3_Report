l /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="12700"><a:solidFill><a:srgbClr val="737373" /></a:solidFill></a:lnB><a:solidFill><a:srgbClr val="F5F5F5" /></a:solidFill></a:tcPr></a:tc></a:tr><a:tr h="373380"><a:tc><a:txBody><a:bodyPr wrap="square" anchor="ctr" /><a:lstStyle /><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="630"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="微软雅黑" /><a:ea typeface="微软雅黑" /><a:cs typeface="微软雅黑" /></a:rPr><a:t>q/k/v 投影 + ShortConv ②</a:t></a:r></a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr"><a:lnL><a:noFill /></a:lnL><a:lnR><a:noFill /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="9525"><a:solidFill><a:srgbClr val="D4D4D4" /></a:solidFill></a:lnB><a:noFill /></a:tcPr></a:tc><a:tc><a:txBody><a:bodyPr wrap="square" anchor="ctr" /><a:lstStyle /><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="630"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="Cambria Math" /><a:ea typeface="Cambria Math" /><a:cs typeface="Cambria Math" /></a:rPr><a:t>x∈ℝ^7168→ q,k∈ℝ^H d_k, v∈ℝ^H d_v</a:t></a:r></a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr"><a:lnL><a:noFill /></a:lnL><a:lnR><a:noFill /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="9525"><a:solidFill><a:srgbClr val="D4D4D4" /></a:solidFill></a:lnB><a:noFill /></a:tcPr></a:tc><a:tc><a:txBody><a:bodyPr wrap="square" anchor="ctr" /><a:lstStyle /><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="630"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="Cambria Math" /><a:ea typeface="Cambria Math" /><a:cs typeface="Cambria Math" /></a:rPr><a:t>2dH(2d_k+d_v)</a:t></a:r></a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr"><a:lnL><a:noFill /></a:lnL><a:lnR><a:noFill /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="9525"><a:solidFill><a:srgbClr val="D4D4D4" /></a:solidFill></a:lnB><a:noFill /></a:tcPr></a:tc><a:tc><a:txBody><a:bodyPr wrap="square" anchor="ctr" /><a:lstStyle /><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="645"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="微软雅黑" /><a:ea typeface="微软雅黑" /><a:cs typeface="微软雅黑" /></a:rPr><a:t>• 稠密 GEMM；Prefill 计算密集，Decode 退化为 GEMV。</a:t></a:r></a:p><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="645"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="微软雅黑" /><a:ea typeface="微软雅黑" /><a:cs typeface="微软雅黑" /></a:rPr><a:t>Prefill 映射 CUBE，Decode 通过权重驻留/融合降低访存。</a:t></a:r></a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr"><a:lnL><a:noFill /></a:lnL><a:lnR><a:noFill /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="9525"><a:solidFill><a:srgbClr val="D4D4D4" /></a:solidFill></a:lnB><a:noFill /></a:tcPr></a:tc></a:tr><a:tr h="373380"><a:tc><a:txBody><a:bodyPr wrap="square" anchor="ctr" /><a:lstStyle /><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="630"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="微软雅黑" /><a:ea typeface="微软雅黑" /><a:cs typeface="微软雅黑" /></a:rPr><a:t>遗忘门 z + 写入 β ①</a:t></a:r></a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr"><a:lnL><a:noFill /></a:lnL><a:lnR><a:noFill /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="9525"><a:solidFill><a:srgbClr val="D4D4D4" /></a:solidFill></a:lnB><a:noFill /></a:tcPr></a:tc><a:tc><a:txBody><a:bodyPr wrap="square" anchor="ctr" /><a:lstStyle /><a:p><a:pPr algn="l"><a:buNone /></a:pPr><a:r><a:rPr sz="630"><a:solidFill><a:srgbClr val="262626" /></a:solidFill><a:latin typeface="Cambria Math" /><a:ea typeface="Cambria Math" /><a:cs typeface="Cambria Math" /></a:rPr><a:t>z=W_zx, β=W_beta x, z∈ℝ^Hd_k</a:t></a:r></a:p></a:txBody><a:tcPr marL="91440" marR="91440" marT="45720" marB="45720" anchor="ctr"><a:lnL><a:noFill /></a:lnL><a:lnR><a:noFill /></a:lnR><a:lnT><a:noFill /></a:lnT><a:lnB w="9525"><a:solidFill><a:s