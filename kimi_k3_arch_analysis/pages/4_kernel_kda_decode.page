  # ===== 右：参数与 FLOPs 表 =====
  - elementId: param-label
    elementType: text
    bounds: [488, 208, 300, 15]
    content:
      style: "$sectitle"
      wrap: false
      align: [left, middle]
      text: 各阶段负载与昇腾诉求
  - elementId: param-table
    elementType: table
    bounds: [488, 240, 436, 196]
    columnWidths: [0.26, 0.26, 0.16, 0.32]
    rowHeights: [0.1, 0.18, 0.18, 0.18, 0.18, 0.18]
    style: "$param"
    rows:
      - - text: 阶段
        - text: 张量形状
        - text: FLOPs
        - text: 负载特征 → 昇腾诉求
      - - text: 短卷积（causal，k=4）
        - text: "[B,H,dk]×4"
        - text: ≈4dk·H / token
        - text: 小卷积 → Vector；独立 kernel 不划算，必须融合
      - - text: 门控（safe-gate）
        - text: g = −5·σ(e<sup>A</sup>·z)
        - text: O(H·dk)
        - text: 纯 Vector；当前 NPU kernel 未融合（host 侧预处理，多一次显存往返）
      - - text: KDA 递归（rank-1 更新）
        - text: "S: [H,dk,dv]，逐 token 串行"
        - text: ≈3H·dk·dv / token
        - text: 小矩阵、并行度仅 B×H 维 → 状态驻留片上是关键
      - - text: 状态重建（replay）
        - text: D 个草稿的投影输入
        - text: D×3H·dk·dv
        - text: 片上重建，免去 D 份状态快照的 HBM 读写
      - - text: 投影输入缓存
        - text: D×(4dk+1)·H×2B
        - text: —
        - text: 仅为状态快照的 ≈4/dv（dv = 128 → ≈1/32）；显存与带宽双省
  - elementId: param-note
    elementType: text
    bounds: [488, 442, 436, 24]
    content:
      fontSize: 7.5
      color: "$gray"
      fontFamily: 黑体
      lineHeight: 1.35
      align: [left, top]
      text: |
        <p>估算（dk = dv = 128、H = 96）：单层状态 3.0MB（BF16）；D = 4 时快照方案读写 ≈12MB / 层 / step，投影缓存 ≈0.4MB / 层。</p>
        <p>注：dk / dv / H 以 checkpoint config 为准；FLOPs 为推算；验证延迟随验证 token 数亚线性增长（报告实测结论）。</p>

  # ===== 底部：开发需求与趋势 =====
  - elementId: dev-label
