pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  # ===== 页眉 =====
  - elementId: source-note
    elementType: text
    bounds: [370, 14, 554, 14]
    content:
      fontSize: 8
      color: "$gray"
      fontFamily: 微软雅黑
      wrap: false
      align: [right, middle]
      text: 资料来源：Kimi K3 Technical Report §2.3 / §5.4.2（Stable LatentMoE）；WarpDecode [12]；vllm-ascend quantization
  - elementId: title
    elementType: text
    bounds: [44, 18, 880, 30]
    content:
      fontSize: 18
      bold: true
      color: "$primary"
      fontFamily: 微软雅黑
      wrap: false
      align: [left, middle]
      text: Stable LatentMoE：隐空间专家计算的 GEMM 优化
  # ===== 分析结论 =====
  - elementId: concl-label-bg
    elementType: shape
    bounds: [44, 58, 88, 110]
    shapeName: rect
    fill: {type: solid, color: "$primary"}
  - elementId: concl-label
    elementType: text
    bounds: [44, 58, 88, 110]
    content:
      fontSize: 14
      bold: true
      color: "#FFFFFF"
      fontFamily: 微软雅黑
      align: [center, middle]
      text: |
        <p>分析</p>
        <p>结论</p>
  - elementId: concl-body-bg
    elementType: shape
    bounds: [140, 58, 784, 110]
    shapeName: rect
    fill: {type: solid, color: "#F2F2F2"}
  - elementId: concl-bullets
    elementType: text
    bounds: [154, 63, 756, 100]
    content:
      fontSize: 9
      color: "$text"
      fontFamily: 微软雅黑
      lineHeight: 1.35
      align: [left, middle]
      text: |
        <ul>
        <li><strong>规模与结构</strong>：896 路由专家 + 每 token 激活 16（稀疏度 56）；路由全宽 d 与专家宽度解耦 —— 专家在 ℓ = 3584（0.5×d）隐空间内计算，路由数增长不再放大通信与权重流量</li>
        <li style="margin-top:4px"><strong>隐空间 GEMM 三优化</strong>：① 下投影与 router 融合为单 GEMM；② 隐空间权重按 rank 分片 + multimem store 将输出 all-gather 融入 GEMM epilogue；③ 通信与共享专家等算子交叠 —— 消除冗余权重流量与重复计算、隐藏通信延迟</li>
        <li style="margin-top:4px"><strong>Decode 困境</strong>：小 batch 下 group GEMM 退化为权重流式读取（memory-bound），tile 中心 kernel（计算导向、预处理开销大）不适用 → WarpDecode token 中心设计：warp 负责单个输出神经元、流式读权重，lane team 细分 + warp 内归约提升并行度</li>
        <li style="margin-top:4px"><strong>量化亲和</strong>：权重布局离线预置换（一次性成本）→ 运行时反量化开销大幅降低，适配 W4A8 / W8A8 量化部署</li>
        </ul>

  # ===== 左：数据流与 decode 设计 =====
  - elementId: arch-label
    elementType: text
    bounds: [44, 180, 320, 15]
    content:
      style: "$sectitle"
      wrap: false
      align: [left, middle]
      text: 隐空间数据流与 decode kernel 设计
  - elementId: arch-figure
    elementType: image
    bounds: [38, 198, 424, 218]
    src: media/latentmoe.png
  - elementId: param-label
    elementType: text
    bounds: [488, 180, 300, 15]
    content:
      style: "$sectitle"
      wrap: false
      align: [left, middle]
      text: 各阶段负载与昇腾诉求
  - elementId: param-table
    elementType: table
    bounds: [488, 208, 436, 196]
    columnWidths: [0.27, 0.25, 0.16, 0.32]
    rowHeights: [0.1, 0.18, 0.18, 0.18, 0.18, 0.18]
    style: "$param"
    rows:
      - - text: 阶段
        - text: 张量形状
        - text: FLOPs
        - text: 负载特征 → 昇腾诉求
      - - text: Router + 下投影融合 ①
        - text: "[T,d]×[d, ℓ+E]"
        - text: 2T·d·(ℓ+E)
        - text: 单 GEMM → CUBE；省一次中间结果写回
      - - text: 路由专家 GEMM
        - text: "每专家 [Te,ℓ]×[ℓ,he]，he = 3072"
        - text: 2k·3ℓ·he，k = 16
        - text: 隐空间 ℓ = 3584（0.5d）→ 计算量较全宽减半；group GEMM → CUBE
      - - text: 上投影 W↑ + AG ②
        - text: "[T,ℓ]×[ℓ,d] + all-gather"
        - text: 2T·ℓ·d
        - text: multimem store 融合 AG → 通信隐藏于计算
      - - text: Decode 权重流读
        - text: 每专家 3·ℓ·he 权重
        - text: ≈0（纯访存）
        - text: memory-bound：带宽利用率为唯一指标 → token 中心 warp 设计
      - - text: 反量化
        - text: W4A8 / W8A8
        - text: 运行时 ≈0
        - text: 离线预置换布局 → 运行时零额外开销
  - elementId: param-note
    elementType: text
    bounds: [488, 410, 436, 24]
    content:
      fontSize: 7.5
      color: "$gray"
      fontFamily: 微软雅黑
      lineHeight: 1.35
      align: [left, top]
      text: |
        <p>每专家权重 3×3584×3072 ≈ 33M 参数（BF16 ≈ 66MB，W4 ≈ 17MB）；decode 单层权重流量 ≈0.26GB（W4）/ 1.06GB（BF16）；E = 896、k = 16（Table 1）。</p>

  # ===== 底部：开发需求与趋势 =====
  - elementId: dev-label
    elementType: text
    bounds: [44, 446, 300, 15]
    content:
      style: "$sectitle"
      wrap: false
      align: [left, middle]
      text: 开发需求与趋势思考
  - elementId: dev-bullets
    elementType: text
    bounds: [44, 466, 876, 68]
    content:
      fontSize: 8
      color: "$text"
      fontFamily: 微软雅黑
      lineHeight: 1.35
      align: [left, top]
      text: |
        <ul>
        <li><strong>算子层（decode）</strong>：token 中心（WarpDecode 式）MoE decode kernel 的 Ascend C 实现 —— lane team 划分与 warp 内归约需映射到 NPU 核内并行模型；配套权重离线预置换工具链</li>
        <li style="margin-top:3px"><strong>算子层（GEMM）</strong>：router + 下投影融合 GEMM；GEMM epilogue 融合 all-gather（multimem store → 昇腾侧对应核间直写 / HCCS 能力）</li>
        <li style="margin-top:3px"><strong>框架层</strong>：vllm-ascend 量化方法（w4a8 / w8a8 / w4a16 / fp8_block 已具备）与 LatentMoE 分片布局对接；EP 规划配合 MoonEP 冗余上界（M ≤ E/R）</li>
        <li style="margin-top:3px"><strong>趋势</strong>：稀疏度 56 使 decode 完全权重带宽受限 —— 量化 + 离线布局 + 通信融合是主线；对昇腾诉求 = HBM 带宽利用率 + 核间直写能力</li>
        </ul>
